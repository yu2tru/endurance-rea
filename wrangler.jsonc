{
  // Cloudflare Workers static-assets config for endurance-rea.com.
  // "name" must match the Worker's name in the Cloudflare dashboard.
  "name": "endurance-rea",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
